# cline-telegram bridge config — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real tokens.

# From @BotFather: /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your numeric Telegram user id (the bridge rejects everyone else).
# Get it by messaging your new bot once, then checking its first
# getUpdates poll (or ask @userinfobot).
TELEGRAM_USER_ID=0
